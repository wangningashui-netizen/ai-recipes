  {
   "id": "107253979",
   "name": "猪肉干 烤箱版 空气炸锅做也行 也可以晾晒蒸出来",
   "url": "https://www.xiachufang.com/recipe/107253979/",
   "author": "微微美厨",
   "score": 8.5,
   "made": 11,
   "desc": "没有烤箱通过这个方子也可以通过晾晒2天，然后上锅蒸15分钟",
   "ingredients": [
    {
     "name": "里脊肉",
     "amount": "3斤"
    },
    {
     "name": "孜然粉",
     "amount": "5克"
    },
    {
