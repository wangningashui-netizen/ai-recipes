      "local": "images/2026-11-28/steps/107825511-6.jpg",
      "source": "https://i2.chuimg.com/7839d5a0cbfd49fab2cb5aaa1bd8f51b_1921w_2560h.jpg"
     }
    },
    {
     "n": 7,
     "text": "放入青椒碎继续翻炒",
     "image": {
      "local": "images/2026-11-28/steps/107825511-7.jpg",
      "source": "https://i2.chuimg.com/223af8d63cca4131ad526e5b2e244b9c_1921w_2560h.jpg"
     }
    },
    {
     "n": 8,
     "text": "加入一勺盐",
     "image": {
      "local": "images/2026-11-28/steps/107825511-8.jpg",
