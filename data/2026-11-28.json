   "steps": [
    {
     "n": 1,
     "text": "💞💞趁热开动吧～浓郁的酱汁拌上米饭，还有大块的肥牛，美滋滋呀……",
     "image": {
      "local": "images/2026-11-28/steps/107028999-1.jpg",
