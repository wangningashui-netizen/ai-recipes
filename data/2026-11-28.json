   },
   "image": {
    "local": "images/2026-11-28/107836402.jpg",
    "source": "https://i2.chuimg.com/c8a076be10e04bada49dc57c418839b3_2154w_2560h.jpg"
   },
   "category": "主食面点",
   "steps": [
    {
     "n": 1,
     "text": "萝卜切丝，加5克盐腌制一个小时，出汤后，挤掉水分。",
     "image": {
      "local": "images/2026-11-28/steps/107836402-1.jpg",
      "source": "https://i2.chuimg.com/46e3931df3184f8881a3c2000b3411c2_2098w_2560h.jpg"
     }
    },
    {
     "n": 2,
     "text": "再加入其他所有调料抓拌均匀",
     "image": {
      "local": "images/2026-11-28/steps/107836402-2.jpg",
      "source": "https://i2.chuimg.com/2f7d1aab61e540f497fb2146df313535_4553w_2560h.jpg"
     }
    },
    {
     "n": 3,
     "text": "抓一把萝卜丝团成球",
     "image": {
      "local": "images/2026-11-28/steps/107836402-3.jpg",
      "source": "https://i2.chuimg.com/d93aa93256354edc9859789b5a26f2d0_2131w_2560h.jpg"
     }
    },
    {
     "n": 4,
     "text": "不粘锅中加入少量油，将萝卜丝球放入锅中压扁，盖上盖子焖3分钟。",
     "image": {
      "local": "images/2026-11-28/steps/107836402-4.jpg",
      "source": "https://i2.chuimg.com/e2c58cfc49a24a128a697dfcae41cd52_2233w_2560h.jpg"
     }
    },
    {
     "n": 5,
     "text": "再翻面盖盖子焖3分钟",
     "image": {
      "local": "images/2026-11-28/steps/107836402-5.jpg",
      "source": "https://i2.chuimg.com/b3153aa965eb4333acde4bc07ee920b2_2044w_2560h.jpg"
     }
    },
    {
     "n": 6,
     "text": "两面金黄后即可",
     "image": {
      "local": "images/2026-11-28/steps/107836402-6.jpg",
      "source": "https://i2.chuimg.com/3d2891783da7415780c081ace1aecc04_2060w_2560h.jpg"
     }
    }
   ]
