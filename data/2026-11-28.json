     "amount": "1勺"
    },
    {
     "name": "料酒",
     "amount": "3勺"
    },
    {
     "name": "蚝油",
     "amount": "3勺"
    },
    {
     "name": "蜂蜜",
     "amount": "3勺"
    },
    {
     "name": "姜",
     "amount": "3片"
    },
    {
     "name": "盐",
     "amount": "9克"
    },
    {
     "name": "香叶",
     "amount": "3片"
    },
    {
     "name": "烧烤料",
     "amount": "适量"
