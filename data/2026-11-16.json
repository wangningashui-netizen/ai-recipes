          "amount": "300g"
        },
        {
          "name": "洋葱",
          "amount": "半个"
        },
        {
          "name": "胡萝卜",
          "amount": "半根"
        },
        {
          "name": "蒜片",
          "amount": "少许"
        },
        {
          "name": "白糖",
          "amount": "1勺"
        },
        {
          "name": "生抽",
          "amount": "4勺"
        },
        {
          "name": "蚝油",
          "amount": "1勺"
        },
        {
          "name": "淀粉",
          "amount": "半勺"
        },
        {
          "name": "黑椒粒",
          "amount": "半勺"
        }
      ],
      "stepCount": 14,
      "lists": [
        "popular"
      ],
      "rank": {
        "popular": 1
      },
      "image": {
        "local": "images/2026-11-16/104033524.jpg",
        "source": "https://i2.chuimg.com/ca4dad60fc8341299a78c8ac7a230838_1256w_1005h.jpg"
      },
      "category": "家常菜",
      "steps": [
        {
          "n": 1,
          "text": "烧水加入姜片",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/48fbc53c01bf4782a6dc6cbee1894f01_1656w_1242h.jpg"
          }
        },
        {
          "n": 2,
          "text": "冰冻的肥牛解冻，我买的是冰冻牛展，比较有嚼劲，超市就有，如果买不到买肥牛也可以的。焯水，到变色马上捞起，不能煮过头，牛肉会失去鲜味",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/a9288e51a8584cc49cd95712b89a8b9e_1656w_1242h.jpg"
          }
        },
        {
          "n": 3,
          "text": "捞起备用",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/fd3186ba2b5c4f05a3ed2a5c9ed883c6_1412w_1242h.jpg"
          }
        },
        {
          "n": 4,
          "text": "调个酱汁，4勺酱油",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/d82fc042ac7c48949df47437bac8705d_1242w_1242h.jpg"
          }
        },
        {
          "n": 5,
          "text": "1勺蚝油",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/870661ab3c444d3d8ebdbc61b8b772e7_1242w_1242h.jpg"
          }
        },
        {
          "n": 6,
          "text": "一勺白糖",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/d0a81db4acf74a0faa0049388f19163e_1242w_1242h.jpg"
          }
        },
        {
          "n": 7,
          "text": "半勺淀粉，再加入几勺清水",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/aaa586c4ad4946afbc7980fd98783406_1298w_1240h.jpg"
          }
        },
        {
          "n": 8,
          "text": "加入半勺黑椒粒，黑椒粉也可以",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/ef9a174c0394487a9fa7bfe551e70bd6_1242w_1242h.jpg"
          }
        },
        {
          "n": 9,
          "text": "锅下油，加入蒜蓉和切好的洋葱",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/3fbfda6e62b742c6973f7c6a6e0039b5_1242w_1242h.jpg"
          }
        },
        {
          "n": 10,
          "text": "洋葱炒出香味后加入胡萝卜，其实可以一起下的",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/50e5bbef4acd43d594a6d7be76304b1c_1656w_1242h.jpg"
          }
        },
        {
          "n": 11,
          "text": "洋葱胡萝卜炒至有些软加入焯过水的肥牛片",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/e1955f25d0794e2185b87627a8529c0e_1464w_1242h.jpg"
          }
        },
        {
          "n": 12,
          "text": "炒半分钟后加入调好的酱汁，翻炒1分钟出锅",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/bec3736d1de647718c4929ea42b4d265_1240w_1250h.jpg"
          }
        },
        {
          "n": 13,
          "text": "超级香的照烧汁肥牛就做好咯",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/4b3a3920857147059dfee91a1a2fee50_1588w_1242h.jpg"
          }
        },
        {
          "n": 14,
          "text": "超级有嚼劲的牛展～",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/9e07d51885d94860a096e731949ea05f_1600w_1242h.jpg"
          }
        }
      ]
    },
    {
      "id": "107299062",
      "name": "绝了～口蘑鸡腿真的好吃，简单快手",
      "url": "https://www.xiachufang.com/recipe/107299062/",
      "author": "李妈妈的食堂",
      "score": 8.0,
      "made": 288,
      "desc": "煮菜的时候已经开始流口水了🤩口蘑的鲜香➕鸡腿肉质鲜嫩，嘎嘎香，嘎嘎好吃❗我家小孩太爱吃了！",
      "ingredients": [
        {
          "name": "口蘑",
          "amount": "250克"
        },
        {
          "name": "手枪鸡腿",
          "amount": "2只"
        },
        {
          "name": "大葱",
          "amount": "1根"
        },
        {
          "name": "姜",
          "amount": "适量"
        },
        {
          "name": "蒜",
          "amount": "适量"
        }
      ],
      "stepCount": 7,
      "lists": [
        "popular"
      ],
      "rank": {
        "popular": 5
      },
      "image": {
        "local": "images/2026-11-16/107299062.jpg",
        "source": "https://i2.chuimg.com/f603954ef70c45cdbce9a05d6550d53d_1920w_2560h.jpg"
      },
      "category": "快手菜",
      "steps": [
        {
          "n": 1,
          "text": "食材处理好：1️⃣口蘑去根部，切4瓣。2️⃣手枪鸡腿剔骨，把鸡肉切块3️⃣大葱斜切段4️⃣姜切粒5️⃣蒜切粒",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/46bb44a89ecc461aaafe0fb57ebff570_1920w_2560h.jpg"
          }
        },
        {
          "n": 2,
          "text": "鸡肉腌制：少许胡椒粉，1茶匙盐，1茶匙鸡粉，2茶匙砂糖，1茶匙淀粉，1勺料酒，1勺蚝油，1勺生抽，搅拌均匀后，加1勺花生油锁味✔️腌制15分钟",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/97e47fc204cd45918a4203386cada0ed_1280w_1707h.jpg"
          }
        },
        {
          "n": 3,
          "text": "👩🏻‍🍳做法：1️⃣热油锅下鸡肉，把两面煎至金黄后放入姜蒜炒出香味2️⃣盛起鸡肉后留底油，放入口蘑炒至焦黄3️⃣倒入鸡肉和大葱，加入料汁翻炒至收汁就可出锅",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/a2afa09803aa455d9f9c540f709ea0b0_1280w_1707h.jpg"
          }
        },
        {
          "n": 4,
          "text": "",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/518b548ca45f402795afbc361e119bd3_1920w_2560h.jpg"
          }
        },
        {
          "n": 5,
          "text": "",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/3840e596c6624ee5a2f02ed27455085b_1920w_2560h.jpg"
          }
        },
        {
          "n": 6,
          "text": "",
          "image": {
            "local": null,
