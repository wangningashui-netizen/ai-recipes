    {
      "id": "107831239",
      "name": "🎃万圣节小零食，烤一盘👻🍠幽灵红薯脆片",
      "url": "https://www.xiachufang.com/recipe/107831239/",
      "author": "Dana大拿",
      "score": null,
      "made": 0,
      "desc": "黄油和红薯也太搭了，烤的时候满屋飘香，奶香奶香的。",
      "ingredients": [
        {
          "name": "红心红薯",
          "amount": "4个"
        },
        {
          "name": "软化黄油",
          "amount": "适量"
        },
        {
          "name": "白砂糖",
          "amount": "适量"
        }
      ],
      "stepCount": 8,
      "lists": [
        "popular"
      ],
      "rank": {
        "popular": 9
      },
      "image": {
        "local": "images/2026-11-16/107831239.jpg",
        "source": "https://i2.chuimg.com/8a109e2c949f4a0395d24446b6ea5cb6_1920w_2560h.jpg"
      },
      "category": "凉菜小吃",
      "steps": [
        {
          "n": 1,
          "text": "红薯表皮清洗干净，最好选用红心红薯，烤出来的颜色和氛围好更强一些。",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/bbcceb976be747caa37fef72a67e6b88_1920w_2560h.jpg"
          }
        },
        {
          "n": 2,
          "text": "擦丝器擦出薄片（这一步一定要小心，不要擦伤手指）清水浸泡掉多余的淀粉",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/d473e402dc16483eb3399897a0f63fa4_1920w_2560h.jpg"
          }
        },
        {
          "n": 3,
          "text": "擦干表面水分，用刀雕刻出表情，表情越搞怪看出来效果越好",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/c16cf43620cd41f5a5ab53823d975619_1920w_2560h.jpg"
          }
        },
        {
          "n": 4,
          "text": "两面都刷一层软化的黄油",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/053c1ab388424abfb2a61bddf6f4ac5c_1920w_2560h.jpg"
          }
        },
        {
          "n": 5,
          "text": "撒上白砂糖，撒一面即可",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/c410f61af87c4517812d08fbdba71b17_1920w_2560h.jpg"
          }
        },
        {
          "n": 6,
          "text": "风炉160度烤25分钟，烘烤的温度和时间根据红薯切片的厚度来调整，总之不要烤糊了就好。刚出炉软软的，放凉后就会变脆",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/154999f85e574c66bdaf0c8e9e43c7f3_1920w_2560h.jpg"
          }
        },
        {
          "n": 7,
          "text": "一盘子可爱鬼👻",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/d158781fa6f940eaa660865757045f31_1920w_2560h.jpg"
          }
        },
        {
          "n": 8,
          "text": "打个灯光，氛围感这不就有了",
          "image": {
            "local": null,
            "source": "https://i2.chuimg.com/7b24f29f82f643669a5aa63ed0e4d6e3_1920w_2560h.jpg"
          }
        }
      ]
    }
  ]
