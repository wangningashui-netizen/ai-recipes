    {
     "n": 17,
     "text": "很好玩的步骤",
     "image": {
      "local": "images/2026-11-22/steps/106746914-17.jpg",
      "source": "https://i2.chuimg.com/8b00e71f128849afbbb5077148d65601_1008w_756h.jpg"
     }
    },
    {
     "n": 18,
     "text": "揉到最后面团很硬",
     "image": {
      "local": "images/2026-11-22/steps/106746914-18.jpg",
      "source": "https://i2.chuimg.com/07f0e885bc424ca7907063b4d60cede0_756w_1008h.jpg"
     }
    },
    {
     "n": 19,
     "text": "啊，细腻的面团，我不会p图罢了。",
     "image": {
      "local": "images/2026-11-22/steps/106746914-19.jpg",
      "source": "https://i2.chuimg.com/f0be524a39a048ad97d0cca5ab287de6_1008w_756h.jpg"
     }
    },
    {
     "n": 20,
     "text": "还有小气孔，我知道。",
     "image": {
      "local": "images/2026-11-22/steps/106746914-20.jpg",
      "source": "https://i2.chuimg.com/7c791ba351c944f5bc1297ffbda37862_756w_1008h.jpg"
     }
    },
    {
     "n": 21,
     "text": "懒得传视频了，有人看再传",
     "image": {
      "local": "images/2026-11-22/steps/106746914-21.jpg",
      "source": "https://i2.chuimg.com/3d8279e597e4482eafb8afa367c0b38a_1008w_756h.jpg"
     }
    },
    {
     "n": 22,
     "text": "憨憨大饼子和小高个的对决",
     "image": {
      "local": "images/2026-11-22/steps/106746914-22.jpg",
      "source": "https://i2.chuimg.com/d6c8a05dd5a64268a92342bb7034d072_1008w_756h.jpg"
     }
    },
    {
     "n": 23,
     "text": "(●'◡'●)",
     "image": {
      "local": "images/2026-11-22/steps/106746914-23.jpg",
      "source": "https://i2.chuimg.com/1b3ff80992ea4c7dbee3f5dd6fb96542_1008w_756h.jpg"
