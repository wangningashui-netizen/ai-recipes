  {
   "id": "104073294",
   "name": "芝麻酒酿饼",
   "url": "https://www.xiachufang.com/recipe/104073294/",
   "author": "kimi小厨",
   "score": 8.4,
   "made": 10,
   "desc": "为了消耗家里自制的酒酿，做了这款饼！没有加馅，也一样好吃！",
   "ingredients": [
    {
     "name": "面粉",
     "amount": "300克"
    },
    {
     "name": "自制酒酿(有米有汁)",
     "amount": "200克"
    },
    {
     "name": "糖",
     "amount": "10克"
    },
    {
     "name": "酵母粉",
     "amount": "3克"
    },
    {
     "name": "色拉油",
     "amount": "5克"
    },
    {
     "name": "泡打粉（没有就不给）",
     "amount": "2克"
    },
    {
     "name": "熟芝麻",
     "amount": "适量"
    }
   ],
   "stepCount": 11,
   "lists": [
    "rising"
   ],
   "rank": {
    "rising": 4
   },
   "image": {
    "local": "images/2026-11-21/104073294.jpg",
    "source": "https://i2.chuimg.com/5b74497fad9a489a930204c2399f7038_1280w_854h.jpg"
   },
   "category": "主食面点",
   "steps": [
    {
     "n": 1,
     "text": "我用的自制酒酿，用的时候，米和汁都要。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-1.jpg",
      "source": "https://i2.chuimg.com/d6229cf145614466b580b39d3c81080e_1080w_810h.jpg"
     }
    },
    {
     "n": 2,
     "text": "所有材料混合在一起，揉成光滑的面团。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-2.jpg",
      "source": "https://i2.chuimg.com/ab425e4e3bf34063953a1b1fcd267833_1080w_810h.jpg"
     }
    },
    {
     "n": 3,
     "text": "发酵至二倍大，手指戳面团不回缩。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-3.jpg",
      "source": "https://i2.chuimg.com/1c2f6736bb9044ee96122dc87b978f9a_1080w_810h.jpg"
     }
    },
    {
     "n": 4,
     "text": "发酵结束后，排气，用呛面法继续揉面团，直至面团切面没有大气孔。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-4.jpg",
      "source": "https://i2.chuimg.com/cd95c40e577740328b3eca1283c0dde1_810w_1080h.jpg"
     }
    },
    {
     "n": 5,
     "text": "分割成六份，松弛10分钟",
     "image": {
      "local": "images/2026-11-21/steps/104073294-5.jpg",
      "source": "https://i2.chuimg.com/4e89be783fe84cb0a9b0c640e2b55c78_1080w_810h.jpg"
     }
    },
    {
     "n": 6,
     "text": "擀成圆饼，进行二发。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-6.jpg",
      "source": "https://i2.chuimg.com/423108729d1849f3a9856592c9ceb55c_1080w_810h.jpg"
     }
    },
    {
     "n": 7,
     "text": "二发大概30分钟即可，发酵完成后，表面刷水，撒上芝麻",
     "image": {
      "local": "images/2026-11-21/steps/104073294-7.jpg",
      "source": "https://i2.chuimg.com/c5fd3ac701404431ae07d570048a5896_1080w_810h.jpg"
     }
    },
    {
     "n": 8,
     "text": "表面垫上一层油纸，加盖一个重一点的盘子。入160度的烤箱，烘烤30-35分钟左右。中途给饼翻一次面。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-8.jpg",
      "source": "https://i2.chuimg.com/a4537c62fa6347269b054e203e2dc6da_1080w_810h.jpg"
     }
    },
    {
     "n": 9,
     "text": "出炉后，放至温热后密封保存。",
     "image": {
      "local": "images/2026-11-21/steps/104073294-9.jpg",
      "source": "https://i2.chuimg.com/2ae03df2690d4d87b8a753e465f7aa7c_1280w_854h.jpg"
     }
    },
    {
     "n": 10,
     "text": "加了酒酿的面粉，有股特别的香气",
     "image": {
      "local": "images/2026-11-21/steps/104073294-10.jpg",
      "source": "https://i2.chuimg.com/ed49d0ec4a9c454d8ce00c4c2d2be7e8_1280w_854h.jpg"
     }
    },
    {
     "n": 11,
     "text": "内部组织～～软硬适中，很好吃！",
     "image": {
      "local": "images/2026-11-21/steps/104073294-11.jpg",
      "source": "https://i2.chuimg.com/40188a3fd2c84f8589b365db1f8e9f0f_1280w_854h.jpg"
     }
    }
   ]
  },
  {
