   ],
   "rank": {
    "rising": 1
   },
   "image": {
    "local": "images/2026-11-21/104306782.jpg",
    "source": "https://i2.chuimg.com/0688b83ec56c48cc80640d8ea51fddc6_3072w_2304h.jpg"
   },
   "category": "家常菜",
   "steps": [
    {
     "n": 1,
     "text": "鲜鸭洗净、去爪、去翅尖、去内脏、擦干水分；",
     "image": {
      "local": "images/2026-11-21/steps/104306782-1.jpg",
      "source": "https://i2.chuimg.com/7e7165f0c00c4d9695a831f2a0310459_2048w_1536h.jpg"
     }
    },
    {
     "n": 2,
     "text": "将腌制酱料灌入腹腔后用针封口；",
     "image": {
      "local": "images/2026-11-21/steps/104306782-2.jpg",
      "source": "https://i2.chuimg.com/149862d7359f430686d99f5e4fffd30b_2048w_1536h.jpg"
     }
    },
    {
     "n": 3,
     "text": "用保鲜膜密封包好入冰箱冷藏过夜；（入味）",
     "image": {
      "local": "images/2026-11-21/steps/104306782-3.jpg",
      "source": "https://i2.chuimg.com/6eb3b352a5614e1f80cab654b9e76880_2048w_1536h.jpg"
     }
    },
    {
     "n": 4,
     "text": "烧一锅滚水，拎住鸭头，将鸭身浸入沸水三提三放后出锅冲冷水降温；（紧皮定型）",
     "image": null
    },
    {
     "n": 5,
     "text": "鸭身均匀刷2次皮水后，挂于阴凉通风处过夜，彻底吊干鸭身表皮水分；（脆皮的关键步骤）",
     "image": {
      "local": "images/2026-11-21/steps/104306782-5.jpg",
      "source": "https://i2.chuimg.com/c287f63e787f45519448353708772c29_3072w_2304h.jpg"
     }
    },
    {
     "n": 6,
     "text": "烤箱预热175度，开热风对流，使用烤架，鸭胸朝上，30分钟；",
     "image": {
      "local": "images/2026-11-21/steps/104306782-6.jpg",
      "source": "https://i2.chuimg.com/09203a7674c84e9f9f1cf26195b72d26_3072w_2304h.jpg"
     }
    },
    {
     "n": 7,
     "text": "30分钟后，反转鸭身，检查上色情况，继续烤20分钟。",
     "image": {
      "local": "images/2026-11-21/steps/104306782-7.jpg",
      "source": "https://i2.chuimg.com/238a5eee6324402b84e23db39c7133a8_2048w_1535h.jpg"
     }
    },
    {
     "n": 8,
     "text": "出炉冷却15分钟；",
     "image": {
      "local": "images/2026-11-21/steps/104306782-8.jpg",
      "source": "https://i2.chuimg.com/db8a75f6382a4d98879c9080e1e74521_2048w_1535h.jpg"
     }
    },
    {
     "n": 9,
     "text": "抽出封腹腔的鸭针，倒出酱汁，斩件配合酱汁和酸梅酱食用。",
     "image": {
      "local": "images/2026-11-21/steps/104306782-9.jpg",
      "source": "https://i2.chuimg.com/b7660f6644074c20b449e1f3a7cdfaef_3072w_2304h.jpg"
     }
    }
   ]
  },
