   "steps": [
    {
     "n": 1,
     "text": "新鲜鲈鱼，让人帮分块切好，回来洗净。",
     "image": {
      "local": "images/2026-11-21/steps/107735156-1.jpg",
      "source": "https://i2.chuimg.com/c9ffb2e288d1421eab3e52b34ebff6e7_1280w_960h.jpg"
     }
    },
    {
     "n": 2,
     "text": "放1茶匙盐、1茶匙白糖、2白瓷勺生抽、少许胡椒粉、1白瓷勺淀粉，翻匀腌制。（小心点，别被鱼骨划伤）",
     "image": {
      "local": "images/2026-11-21/steps/107735156-2.jpg",
      "source": "https://i2.chuimg.com/98d004385a23463aad407e5ae7760084_1280w_959h.jpg"
     }
    },
    {
     "n": 3,
     "text": "切点红青椒和姜丝。",
     "image": {
