  {
   "id": "106789618",
   "name": "绝对不能错过！好吃到舔盘的椒盐大虾🦐",
   "url": "https://www.xiachufang.com/recipe/106789618/",
   "author": "古典美人美食",
   "score": 7.8,
   "made": 886,
   "desc": "春季是孩子长个的黄金期，我每次都会做虾🦐给儿子吃，虾含蛋白质含钙量高，今天做个不一样虾的吃法《椒盐大虾》，每次做孩子们都特开心，真的特别好吃😋外酥里嫩的，酥脆的外皮裹着大虾，吃一口超满足，关键做法也简单哦！",
   "ingredients": [
    {
     "name": "大虾",
     "amount": "1斤"
    },
    {
     "name": "鸡蛋",
     "amount": "2个"
    },
    {
     "name": "玉米淀粉",
     "amount": "3大勺（口径4cm"
    },
    {
     "name": "葱",
     "amount": "1根"
    },
    {
     "name": "姜",
     "amount": "3/4片"
    }
   ],
   "stepCount": 13,
   "lists": [
    "popular"
   ],
   "rank": {
    "popular": 3
   },
   "image": {
    "local": "images/2026-11-21/106789618.jpg",
    "source": "https://i2.chuimg.com/92b2a14629a44baf82e7d1412bc37dc8_1125w_1480h.jpg"
   },
   "category": "家常菜",
   "steps": [
    {
     "n": 1,
     "text": "准备新鲜大虾2斤",
     "image": {
      "local": "images/2026-11-21/steps/106789618-1.jpg",
      "source": "https://i2.chuimg.com/868f928ff117419aa2bdf9043f1e569c_1920w_2560h.jpg"
     }
    },
    {
     "n": 2,
     "text": "虾去皮去虾线开背，留点虾的小尾巴",
     "image": {
      "local": "images/2026-11-21/steps/106789618-2.jpg",
      "source": "https://i2.chuimg.com/c4cca011ab984fb180709226726c72b9_1464w_1171h.jpg"
     }
    },
    {
     "n": 3,
     "text": "加几片生姜和葱，一勺料酒",
     "image": {
      "local": "images/2026-11-21/steps/106789618-3.jpg",
      "source": "https://i2.chuimg.com/147837b54bb0495cb57dcc2b5d67a3e6_1411w_1129h.jpg"
     }
    },
    {
     "n": 4,
     "text": "加2勺生抽",
     "image": {
      "local": "images/2026-11-21/steps/106789618-4.jpg",
      "source": "https://i2.chuimg.com/ccf0715e7930438b998c914473d218fc_1401w_1121h.jpg"
     }
    },
    {
     "n": 5,
     "text": "适量盐和胡椒粉",
     "image": {
      "local": "images/2026-11-21/steps/106789618-5.jpg",
      "source": "https://i2.chuimg.com/585f412621dd40e8a90e1f0b3a11e03f_1400w_1120h.jpg"
     }
    },
    {
     "n": 6,
     "text": "抓匀腌制20分钟",
     "image": {
      "local": "images/2026-11-21/steps/106789618-6.jpg",
      "source": "https://i2.chuimg.com/4343344a1743455b9c0ddcf68dcf6a5f_1361w_1089h.jpg"
     }
    },
    {
     "n": 7,
     "text": "碗中加3大勺玉米淀粉（口径4cm",
     "image": {
      "local": "images/2026-11-21/steps/106789618-7.jpg",
      "source": "https://i2.chuimg.com/9803fd33590348cd9a504a8881461188_858w_687h.jpg"
     }
    },
    {
     "n": 8,
     "text": "搅拌成酸奶状（如果太干了加点水稀释）",
     "image": {
      "local": "images/2026-11-21/steps/106789618-8.jpg",
      "source": "https://i2.chuimg.com/42f57dc8f5ec4816af62fbed85970f49_899w_719h.jpg"
     }
    },
    {
     "n": 9,
     "text": "每个虾裹上蛋液糊",
     "image": {
      "local": "images/2026-11-21/steps/106789618-9.jpg",
      "source": "https://i2.chuimg.com/01cd66a150b64fdcac45bb1a3aedc6ed_1688w_1350h.jpg"
     }
    },
    {
     "n": 10,
     "text": "油温6成开始炸，炸至漂浮捞出（喜欢吃脆点的可以油温升高后再复炸一遍）我就炸一遍，看个人喜好🤗",
     "image": {
      "local": "images/2026-11-21/steps/106789618-10.jpg",
      "source": "https://i2.chuimg.com/2de1bb072056458d82f17f200232d671_1920w_1536h.jpg"
     }
    },
    {
     "n": 11,
     "text": "看这颜色就诱惑不住了🤣",
     "image": {
      "local": "images/2026-11-21/steps/106789618-11.jpg",
      "source": "https://i2.chuimg.com/e17e1bb350a2488ea2efb65bbfa402a9_1920w_1536h.jpg"
     }
    },
    {
     "n": 12,
     "text": "金黄酥脆，好吃到吮手指😍",
     "image": {
      "local": "images/2026-11-21/steps/106789618-12.jpg",
      "source": "https://i2.chuimg.com/06c1de2885174297abdc663d4e111c3f_898w_719h.jpg"
     }
    },
    {
     "n": 13,
     "text": "撒上椒盐或香辣粉就可以开吃咯！（喜欢的厨友们你也安排起来吧，保证儿子夸你是大厨👍）",
     "image": {
      "local": "images/2026-11-21/steps/106789618-13.jpg",
      "source": "https://i2.chuimg.com/de0dd0e8629449c898f62378b7583720_1065w_852h.jpg"
     }
    }
   ]
