    "source": "https://i2.chuimg.com/dbd00a53a29a4b4ba13cf1519cfb78bb_864w_1152h.jpg"
   },
   "category": "主食面点",
   "steps": [
    {
     "n": 1,
     "text": "活发面，韭菜鸡蛋虾皮馅，包小包子",
     "image": {
      "local": "images/2026-11-27/steps/103430092-1.jpg",
      "source": "https://i2.chuimg.com/e8dcb7a3d97942509505afeb2e39974c_864w_1152h.jpg"
     }
    },
    {
     "n": 2,
     "text": "电饼铛预热，只开下盘开关就行，滴一点油，摆入包子，煎至有点发黄，调面粉水（水里放一点面粉搅拌均匀），倒入电饼铛一厘米，至到水干就熟了。",
     "image": {
      "local": "images/2026-11-27/steps/103430092-2.jpg",
      "source": "https://i2.chuimg.com/ede6ff96484a4c4cba1c194f743a8d35_864w_1152h.jpg"
     }
    },
    {
     "n": 3,
     "text": "开吃了，香喷喷的",
     "image": {
      "local": "images/2026-11-27/steps/103430092-3.jpg",
      "source": "https://i2.chuimg.com/c4ff923370a34cdd8be3fb37b5eedc27_864w_1152h.jpg"
     }
    },
    {
     "n": 4,
     "text": "做过太多次了",
     "image": {
      "local": "images/2026-11-27/steps/103430092-4.jpg",
      "source": "https://i2.chuimg.com/c697e72dc1c84c89ba247040cc75e4b9_864w_1152h.jpg"
     }
    },
    {
     "n": 5,
     "text": "这个是掺了玉米面的，没放馅，就是水煎小馒头了，和水煎包做法一样。",
     "image": {
      "local": "images/2026-11-27/steps/103430092-5.jpg",
      "source": "https://i2.chuimg.com/d414611928fa41ad9d82b6730ebf2c4c_864w_1152h.jpg"
     }
    }
   ]
  }
 ]
