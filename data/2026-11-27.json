  {
   "id": "106488658",
   "name": "西红柿炒鸡蛋",
   "url": "https://www.xiachufang.com/recipe/106488658/",
   "author": "五月孤芳",
   "score": 8.1,
   "made": 3999,
   "desc": "看似很简单的一道菜，要想炒出来好吃，还是需要技巧的~",
   "ingredients": [
    {
     "name": "鸡蛋",
     "amount": "3个"
    },
    {
     "name": "西红柿",
     "amount": "2个"
    },
    {
     "name": "葱",
     "amount": "1根"
    },
    {
     "name": "蒜",
     "amount": "1瓣"
    },
    {
     "name": "盐",
     "amount": "适量"
    },
    {
     "name": "糖",
     "amount": "适量"
    }
   ],
   "stepCount": 16,
   "lists": [
    "popular"
   ],
   "rank": {
    "popular": 23
   },
   "image": {
    "local": "images/2026-11-27/106488658.jpg",
    "source": "https://i2.chuimg.com/cbf28b18d47a4c378ad7c702dc9da6f8_1280w_956h.jpg"
   },
   "category": "家常菜",
   "steps": [
    {
     "n": 1,
     "text": "准备好所需材料；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-1.jpg",
      "source": "https://i2.chuimg.com/db7f32e056764ea9af7b1a0a94162b7f_1280w_959h.jpg"
     }
    },
    {
     "n": 2,
     "text": "在西红柿顶部划两刀，放入开水中烫一分钟便可去皮；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-2.jpg",
      "source": "https://i2.chuimg.com/5f472a67c1c1476d8f044825af15625b_1280w_959h.jpg"
     }
    },
    {
     "n": 3,
     "text": "切成滚刀块；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-3.jpg",
      "source": "https://i2.chuimg.com/4e844db392b04a3e98dc112be187a807_1280w_960h.jpg"
     }
    },
    {
     "n": 4,
     "text": "准备好葱花和蒜末；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-4.jpg",
      "source": "https://i2.chuimg.com/66cc58570bc84c2fad626d919f005dfd_1280w_960h.jpg"
     }
    },
    {
     "n": 5,
     "text": "鸡蛋磕入碗中，加少许盐，打散；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-5.jpg",
      "source": "https://i2.chuimg.com/e4668f47c0a240b499788ca3fed485a6_1280w_960h.jpg"
     }
    },
    {
     "n": 6,
     "text": "锅烧热，倒油，油要适当多一些；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-6.jpg",
      "source": "https://i2.chuimg.com/96ca86bfeaa341988e3a6d4fffa10e9f_1280w_960h.jpg"
     }
    },
    {
     "n": 7,
     "text": "油热后，关小火，倒入蛋液，待蛋液还未完全凝固时，关火，这样鸡蛋才滑嫩；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-7.jpg",
      "source": "https://i2.chuimg.com/8f1ec0f2721d49c2bef4ad4b99b8495d_1280w_959h.jpg"
     }
    },
    {
     "n": 8,
     "text": "用筷子把鸡蛋划散；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-8.jpg",
      "source": "https://i2.chuimg.com/dbe261c5c693497096d02dda681cb3d6_1280w_959h.jpg"
     }
    },
    {
     "n": 9,
     "text": "鸡蛋炒好后盛出来，避免继续受热变老；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-9.jpg",
      "source": "https://i2.chuimg.com/587bf4fc00bd474ca9f374cef9ec2a85_1280w_960h.jpg"
     }
    },
    {
     "n": 10,
     "text": "倒入少许底油，关小火，爆香蒜末；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-10.jpg",
      "source": "https://i2.chuimg.com/4ecea43399f4402cbdac6951c8216c03_1280w_960h.jpg"
     }
    },
    {
     "n": 11,
     "text": "倒入西红柿块，用中火翻炒，才能炒出更多的汤汁；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-11.jpg",
      "source": "https://i2.chuimg.com/5ac7a28fe942453b901c5cb0c24258cb_1280w_960h.jpg"
     }
    },
    {
     "n": 12,
     "text": "炒出汤汁后，加入适量盐和白糖调味；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-12.jpg",
      "source": "https://i2.chuimg.com/502aa41d7ceb4023880ce96c921727dd_1280w_960h.jpg"
     }
    },
    {
     "n": 13,
     "text": "再倒入鸡蛋，快速翻炒均匀；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-13.jpg",
      "source": "https://i2.chuimg.com/d025185f892240c5a7665640e5109506_1280w_960h.jpg"
     }
    },
    {
     "n": 14,
     "text": "若汁水过多，可以勾点芡汁；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-14.jpg",
      "source": "https://i2.chuimg.com/324f092359144825a4ea85505a4225d7_1280w_959h.jpg"
     }
    },
    {
     "n": 15,
     "text": "出锅装盘，撒上葱花做点缀；",
     "image": {
      "local": "images/2026-11-27/steps/106488658-15.jpg",
      "source": "https://i2.chuimg.com/c791bdc1b6974f95a03484da8a953e5b_1280w_959h.jpg"
     }
    },
    {
     "n": 16,
     "text": "跟小时候吃过的味道一样～",
     "image": {
      "local": "images/2026-11-27/steps/106488658-16.jpg",
      "source": "https://i2.chuimg.com/374d32860b23458db9ec80deb910ffe6_1280w_959h.jpg"
     }
    }
   ]
  },
