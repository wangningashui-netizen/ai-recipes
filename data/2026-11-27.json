   "stepCount": 12,
   "lists": [
    "popular"
   ],
   "rank": {
    "popular": 24
   },
   "image": {
    "local": "images/2026-11-27/107756751.jpg",
    "source": "https://i2.chuimg.com/cfe1136571614ef185116f46cd52c420_1920w_2560h.jpg"
   },
   "category": "烘焙甜点",
   "steps": [
    {
     "n": 1,
     "text": "波兰种：高筋粉➕水➕酵母混合均匀，室温发酵至3倍大后，可以直接用也可放冰箱冷藏1-2天用。",
     "image": {
      "local": "images/2026-11-27/steps/107756751-1.jpg",
      "source": "https://i2.chuimg.com/da8c931b8da241b88314b06e08e8cbe5_3349w_2560h.jpg"
     }
    },
    {
     "n": 2,
     "text": "除黄油以外的材料混合，用厨师机揉出厚膜，加入软化的黄油，继续揉至透明光滑的手套膜。",
     "image": {
      "local": "images/2026-11-27/steps/107756751-2.jpg",
      "source": "https://i2.chuimg.com/5ccae3392d8140c9a76a6ff2ed53d569_3842w_2560h.jpg"
     }
    },
    {
     "n": 3,
     "text": "整理成团，发酵至两倍大",
     "image": {
      "local": "images/2026-11-27/steps/107756751-3.jpg",
      "source": "https://i2.chuimg.com/1613d58ff5f94cbe8b9883a5448f3351_4554w_2560h.jpg"
     }
    },
    {
     "n": 4,
     "text": "面团平均分成6等份，松弛15分钟，擀开，放入圆形纸模中，擀面杖粘上面粉在面团中间按压个圆。放入温度35度湿度80的环境下发酵，约35分钟左右。发酵的时候可制作乳酪馅：奶油奶酪隔热水融化，加入糖粉、奶粉拌匀，装入裱花袋备用。",
     "image": {
      "local": "images/2026-11-27/steps/107756751-4.jpg",
      "source": "https://i2.chuimg.com/ac2aa1f5d16e4759b36fcd8100889145_3842w_2560h.jpg"
     }
    },
    {
     "n": 5,
     "text": "制作酥粒：低筋面粉➕黄油➕糖粉混合拌匀搓成粒即可。",
     "image": {
      "local": "images/2026-11-27/steps/107756751-5.jpg",
      "source": "https://i2.chuimg.com/bd5c3ba5075e476ea5214e6f5b61a1e5_1921w_2560h.jpg"
     }
    },
    {
     "n": 6,
     "text": "发酵好的时候，烤箱上下火200度提前预热。面团表面刷一层鸡蛋液，中间挤入乳酪酱，边缘撒上酥粒",
     "image": {
      "local": "images/2026-11-27/steps/107756751-6.jpg",
      "source": "https://i2.chuimg.com/9c0bb18f3e9949d69ab028ae06286b62_3414w_2560h.jpg"
     }
    },
    {
     "n": 7,
     "text": "中间摆上蓝莓",
     "image": {
      "local": "images/2026-11-27/steps/107756751-7.jpg",
      "source": "https://i2.chuimg.com/77157c65a7ba4457a4901effb0c501a7_3414w_2560h.jpg"
     }
    },
    {
     "n": 8,
     "text": "烤箱上下火185度烤15分钟左右，注意观察上色，温度时间仅供参考。",
     "image": {
      "local": "images/2026-11-27/steps/107756751-8.jpg",
      "source": "https://i2.chuimg.com/c182f313580f454ba2af0f466285887e_3414w_2560h.jpg"
     }
    },
    {
     "n": 9,
     "text": "",
     "image": {
      "local": "images/2026-11-27/steps/107756751-9.jpg",
      "source": "https://i2.chuimg.com/9fb8c5dcb78c4deabca2cdd3240283a1_3414w_2560h.jpg"
     }
    },
    {
     "n": 10,
     "text": "",
     "image": {
      "local": "images/2026-11-27/steps/107756751-10.jpg",
      "source": "https://i2.chuimg.com/65d6d2b184d74a8b82ee432b6aee7307_3714w_2560h.jpg"
     }
    },
    {
     "n": 11,
     "text": "取出脱模、晾凉",
     "image": {
      "local": "images/2026-11-27/steps/107756751-11.jpg",
      "source": "https://i2.chuimg.com/aca61a9c803642e28b41ba50eca2c50b_1921w_2560h.jpg"
     }
    },
    {
     "n": 12,
     "text": "超级松软，搭配奶香浓郁的奶酪馅，一口沦陷！",
     "image": {
      "local": "images/2026-11-27/steps/107756751-12.jpg",
      "source": "https://i2.chuimg.com/b8cadbc324534878a26b1d5e0d9c2469_2348w_2560h.jpg"
     }
    }
   ]
